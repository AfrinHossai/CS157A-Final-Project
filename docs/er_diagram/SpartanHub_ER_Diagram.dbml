// Spartan Study Hub: ER-diagram source.
// Enrollment and GroupMember use composite primary keys for many-to-many relationships.

Table User {
  user_id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(50) [not null]
  created_at timestamp [not null, default: `now()`]
}

Table Department {
  department_id int [pk, increment]
  department_name varchar(150) [not null]
  department_code varchar(20) [not null, unique]
}

Table Course {
  course_id int [pk, increment]
  department_id int [not null]
  course_code varchar(30) [not null, unique]
  course_title varchar(200) [not null]
  description text
}

Table Enrollment {
  user_id int [not null]
  course_id int [not null]
  enrollment_date date [not null]

  indexes {
    (user_id, course_id) [pk]
  }
}

Table StudyGroup {
  group_id int [pk, increment]
  course_id int [not null]
  created_by int [not null]
  group_name varchar(150) [not null]
  description text
  member_limit int [not null]
  created_at timestamp [not null, default: `now()`]
}

Table GroupMember {
  group_id int [not null]
  user_id int [not null]
  join_date date [not null]
  member_role varchar(50) [not null]

  indexes {
    (group_id, user_id) [pk]
  }
}

Table StudySession {
  session_id int [pk, increment]
  group_id int [not null]
  created_by int [not null]
  session_date date [not null]
  start_time time [not null]
  location varchar(255) [not null]
  topic varchar(200) [not null]
  description text
}

Table Resource {
  resource_id int [pk, increment]
  course_id int [not null]
  uploaded_by int [not null]
  title varchar(200) [not null]
  description text
  resource_type varchar(50) [not null]
  resource_url varchar(2048) [not null]
  created_at timestamp [not null, default: `now()`]
}

Table Message {
  message_id int [pk, increment]
  group_id int [not null]
  sender_id int [not null]
  message_text text [not null]
  sent_at timestamp [not null, default: `now()`]
}

Table Notification {
  notification_id int [pk, increment]
  user_id int [not null]
  notification_type varchar(50) [not null]
  notification_text text [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

// Department -> Courses
Ref: Course.department_id > Department.department_id

// Users <-> Courses through Enrollment
Ref: Enrollment.user_id > User.user_id
Ref: Enrollment.course_id > Course.course_id

// Course -> StudyGroups; User -> created StudyGroups
Ref: StudyGroup.course_id > Course.course_id
Ref: StudyGroup.created_by > User.user_id

// Users <-> StudyGroups through GroupMember
Ref: GroupMember.group_id > StudyGroup.group_id
Ref: GroupMember.user_id > User.user_id

// StudyGroup -> StudySessions; User -> created StudySessions
Ref: StudySession.group_id > StudyGroup.group_id
Ref: StudySession.created_by > User.user_id

// Course -> Resources; User -> uploaded Resources
Ref: Resource.course_id > Course.course_id
Ref: Resource.uploaded_by > User.user_id

// StudyGroup -> Messages; User -> sent Messages
Ref: Message.group_id > StudyGroup.group_id
Ref: Message.sender_id > User.user_id

// User -> received Notifications
Ref: Notification.user_id > User.user_id
